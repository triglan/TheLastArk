    private static List<EnemyEncounterData> CollectValidEncounters(
        EnemyEncounterPool pool,
        IReadOnlyCollection<string> appearedEncounterIds,
        bool allowDuplicates)
    {
        List<EnemyEncounterData> result = new List<EnemyEncounterData>();
        foreach (EnemyEncounterData encounter in pool.Encounters)
        {
            if (encounter == null || !encounter.HasAnyEnemy) continue;
            if (!allowDuplicates && HasAppeared(appearedEncounterIds, encounter.EncounterId)) continue;
            result.Add(encounter);
        }
        return result;
    }

    private static bool HasAppeared(IReadOnlyCollection<string> appearedEncounterIds, string encounterId)
    {
        if (appearedEncounterIds == null) return false;
=======
        Debug.Log($"[EncounterResolver] Resolve region={regionId}, floor={floor}, nodeType={nodeType}, combatCount={combatCount}");

        if (table == null)
        {
            Debug.LogError("[EncounterResolver] BattleEncounterTable could not be loaded. Fallback is disabled.");
            return null;
        }

        List<EnemyEncounterPool> matchedPools = CollectHighestPriorityPools(table, regionId, nodeType, floor, combatCount);
        if (matchedPools.Count == 0)
        {
            Debug.LogError($"[EncounterResolver] No pool matched region={regionId}, floor={floor}, nodeType={nodeType}, combatCount={combatCount}. Fallback is disabled.");
            return null;
        }

        int requiredEnemyCount = GetRequiredEnemyCount(nodeType, floor);
        List<EnemyEncounterData> valid = CollectValidEncounters(matchedPools, appearedEncounterIds, false, requiredEnemyCount, floor);

        if (valid.Count == 0)
        {
            Debug.LogWarning("[EncounterResolver] No non-duplicate formation remained. Reusing a valid formation from the same matched pools.");
            valid = CollectValidEncounters(matchedPools, appearedEncounterIds, true, requiredEnemyCount, floor);
        }

        if (valid.Count == 0)
        {
            Debug.LogError($"[EncounterResolver] Matched pools contain no valid formation for floor={floor}, nodeType={nodeType}, requiredEnemyCount={FormatRequiredCount(requiredEnemyCount)}. Cross-region and cross-floor fallback is disabled.");
            return null;
        }

        EnemyEncounterData selected = valid[Random.Range(0, valid.Count)];
        Debug.Log($"[EncounterResolver] Selected formation='{selected.DisplayName}', enemyCount={selected.EnemyCount}, candidateCount={valid.Count}, fallback=false");
        return selected;
    }

    private static List<EnemyEncounterPool> CollectHighestPriorityPools(
        BattleEncounterTable table,
        string regionId,
        NodeType nodeType,
        int floor,
        int combatCount)
    {
        List<EnemyEncounterPool> result = new List<EnemyEncounterPool>();
        int highestPriority = int.MinValue;

        foreach (EnemyEncounterPool pool in table.GetPoolsForRegion(regionId))
        {
            if (pool == null) continue;

            bool matches = pool.Matches(regionId, nodeType, floor, combatCount);
            Debug.Log($"[EncounterResolver] Pool='{pool.DisplayName}', range={pool.MinFloor}~{pool.MaxFloor}, nodeType={pool.NodeType}, priority={pool.Priority}, matches={matches}");
            if (!matches) continue;

            if (pool.Priority > highestPriority)
            {
                highestPriority = pool.Priority;
                result.Clear();
            }

            if (pool.Priority == highestPriority) result.Add(pool);
        }

        return result;
    }

    private static List<EnemyEncounterData> CollectValidEncounters(
        IReadOnlyList<EnemyEncounterPool> pools,
        IReadOnlyCollection<string> appearedEncounterIds,
        bool allowDuplicates,
        int requiredEnemyCount,
        int floor)
    {
        List<EnemyEncounterData> result = new List<EnemyEncounterData>();
        HashSet<EnemyEncounterData> emitted = new HashSet<EnemyEncounterData>();

        for (int poolIndex = 0; poolIndex < pools.Count; poolIndex++)
        {
            EnemyEncounterPool pool = pools[poolIndex];
            if (pool == null) continue;

            foreach (EnemyEncounterData encounter in pool.Encounters)
            {
                if (encounter == null || emitted.Contains(encounter)) continue;

                int enemyCount = encounter.EnemyCount;
                bool countMatches = requiredEnemyCount == NoRequiredEnemyCount || enemyCount == requiredEnemyCount;
                bool duplicate = HasAppeared(appearedEncounterIds, encounter.EncounterId);

                Debug.Log($"[EncounterResolver] Candidate pool='{pool.DisplayName}', formation='{encounter.DisplayName}', enemyCount={enemyCount}, required={FormatRequiredCount(requiredEnemyCount)}, duplicate={duplicate}");

                if (!encounter.HasAnyEnemy)
                {
                    Debug.LogWarning($"[EncounterResolver] Rejected empty formation '{encounter.DisplayName}'.", encounter);
                    continue;
                }

                if (!countMatches)
                {
                    Debug.LogWarning($"[EncounterResolver] Rejected formation '{encounter.DisplayName}' at floor {floor}: expected {requiredEnemyCount} enemies, actual {enemyCount}.", encounter);
                    continue;
                }

                if (!allowDuplicates && duplicate) continue;

                emitted.Add(encounter);
                result.Add(encounter);
            }
        }

        return result;
    }

    private static int GetRequiredEnemyCount(NodeType nodeType, int floor)
    {
        if (nodeType != NodeType.Combat) return NoRequiredEnemyCount;
        if (floor >= 1 && floor <= 3) return 1;
        if (floor >= 4 && floor <= 6) return 2;
        return NoRequiredEnemyCount;
    }

    private static string FormatRequiredCount(int requiredEnemyCount)
    {
        return requiredEnemyCount == NoRequiredEnemyCount ? "any" : requiredEnemyCount.ToString();
    }

