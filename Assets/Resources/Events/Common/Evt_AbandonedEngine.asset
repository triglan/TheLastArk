  m_Script: {fileID: 11500000, guid: 60773063327c2eb4fbd38c2745ec336b, type: 3}
  m_Name: Evt_AbandonedEngine
  m_EditorClassIdentifier: 
  eventID: evt_abandoned_engine
  eventTitle: "\uBC84\uB824\uC9C4 \uB9C8\uB3C4\uACF5\uD559 \uC5D4\uC9C4"
  eventDescription: "\uC120\uB85C \uC606\uC5D0 \uAC70\uB300\uD55C \uB9C8\uB3C4\uACF5\uD559
    \uC5D4\uC9C4 \uD558\uB098\uAC00 \uBC84\uB824\uC838 \uC788\uC2B5\uB2C8\uB2E4.
    \n\uD55C\uB54C\uB294 \uAC70\uB300\uD55C \uBE44\uACF5\uC815\uC744 \uB744\uC6E0\uC744
    \uC5D4\uC9C4\uC774\uC9C0\uB9CC, \n\uC9C0\uAE08\uC740 \uBCF4\uB78F\uBE5B \uC99D\uAE30\uB97C
    \uBFDC\uC5B4\uB0B4\uBA70 \uBD88\uC548\uC815\uD558\uAC8C \uB9E5\uB3D9\uD558\uACE0
    \uC788\uC2B5\uB2C8\uB2E4. \n\uC81C\uB300\uB85C\uB9CC \uB2E4\uB8EC\uB2E4\uBA74
    \uC5F4\uCC28\uC5D0 \uC5C4\uCCAD\uB09C \uB3D9\uB825\uC744 \uC81C\uACF5\uD558\uACA0\uC9C0\uB9CC,
    \n\uC790\uCE6B \uC798\uBABB \uAC74\uB4DC\uB838\uB2E4\uAC04 \uC774 \uAD6C\uC5ED
    \uC804\uCCB4\uAC00 \uB9C8\uB825 \uD3ED\uBC1C\uC5D0 \uD718\uB9D0\uB9B4\uC9C0\uB3C4
    \uBAA8\uB985\uB2C8\uB2E4."
  eventImage: {fileID: 21300000, guid: 7b79f9921e9f348459a96c2b03f8b835, type: 3}
  imageOffset: {x: 0, y: 0}
  imageScale: 1
  options:
  - optionText: "\uC5D4\uC9C4\uC744 \uBE60\uB974\uAC8C \uC0B4\uD3B4\uBCF8\uB2E4."
    requirementType: 0
    requirementValue: 0
    requirementDataID: 
    outcomes:
    - outcomeText: "\uB2F9\uC2E0\uC740 \uC5D4\uC9C4 \uB0B4\uBD80\uC758 \uBCF5\uC7A1\uD55C
        \uB9C8\uB825 \uD575\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0, \uC678\uBCBD\uC5D0
        \uB290\uC2A8\uD558\uAC8C \uBC15\uD600 \uC788\uB294 \uBD80\uD488\uB4E4\uC744
        \uC2E0\uC18D\uD558\uAC8C \uB72F\uC5B4\uB0C5\uB2C8\uB2E4. \uC5D4\uC9C4\uC740
        \"\uCE58\uC775-\" \uD558\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8 \uAE30\uBD84
        \uB098\uC05C \uC99D\uAE30\uB97C \uD1A0\uD574\uB0B4\uC9C0\uB9CC, \uC801\uC5B4\uB3C4
        \uD3ED\uBC1C\uD558\uC9C4 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 8
        rewardValue: 1
        rewardDataID: "\uBB34\uC791\uC704 \uC18C\uBAA8\uD488"
  - optionText: "\uC5D4\uC9C4\uC744 \uC815\uBC00\uD558\uAC8C \uC810\uAC80\uD55C\uB2E4."
    requirementType: 3
    requirementValue: 8
    requirementDataID: 
    outcomes:
    - outcomeText: "\uB2F9\uC2E0\uC758 \uB300\uC6D0\uC774 \uC228\uC744 \uBA48\uCD94\uACE0,
        \uC5BD\uD78C \uD68C\uB85C \uC0AC\uC774\uB85C \uC190\uC744 \uC9D1\uC5B4\uB123\uC2B5\uB2C8\uB2E4.
        \uAC10\uAC01\uC744 \uADF9\uB3C4\uB85C \uACE4\uB450\uC138\uC6B0\uC790, \uBBF8\uC138\uD55C
        \uB9C8\uB825\uC758 \uD750\uB984\uC774 \uB290\uAEF4\uC9D1\uB2C8\uB2E4. \uACB0\uC815\uC801\uC778
        \uC21C\uAC04\uC5D0 \uD68C\uB85C\uB97C \uC870\uC791\uD558\uC790, \uC5D4\uC9C4\uC774
        \uBD80\uB4DC\uB7EC\uC6B4 \uAE30\uACC4\uC74C\uC744 \uB0B4\uBA70 \uC815\uD654\uB41C
        \uC5D0\uB108\uC9C0\uB97C \uBFDC\uC5B4\uB0C5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740
        \uC774 \uC5D4\uC9C4\uC5D0 \uB2F4\uAE34 \uD601\uC2E0\uC801\uC778 \uB9C8\uB3C4\uD559
        \uC124\uACC4 \uAD6C\uC870\uB97C \uC6B0\uB9AC \uC5F4\uCC28\uC5D0 \uADF8\uB300\uB85C
        \uC774\uC2DD\uD558\uB294 \uB370 \uC131\uACF5\uD569\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 9
        rewardValue: 1
        rewardDataID: 
  - optionText: "\uC5D4\uC9C4\uC744 \uD1B5\uC9F8\uB85C \uACAC\uC778\uD55C\uB2E4."
    requirementType: 0
    requirementValue: 0
    requirementDataID: 
    outcomes:
    - outcomeText: "\uC815\uAD50\uD55C \uD574\uCCB4? \uADF8\uAC8C \uBB54\uAC00\uC694?
        \uB2F9\uC2E0\uC740 \uC5D4\uC9C4 \uC804\uCCB4\uB97C \uC5F4\uCC28\uC758 \uBCF4\uC870
        \uB3D9\uB825\uC2E4\uC5D0 \uC9C1\uACB0\uD558\uAE30\uB85C \uD569\uB2C8\uB2E4.
        \uACFC\uBD80\uD558\uAC00 \uAC78\uB9B0 \uC5D4\uC9C4\uC774 \uBE44\uBA85\uC744
        \uC9C0\uB974\uBA70 \uBD88\uAF43\uC744 \uD280\uAE30\uC9C0\uB9CC, \uADF8\uC640
        \uB3D9\uC2DC\uC5D0 \uC5F4\uCC28\uC758 \uBAA8\uB4E0 \uAD6C\uB3D9 \uC7A5\uCE58\uC5D0
        \uD3ED\uBC1C\uC801\uC778 \uB9C8\uB825\uC774 \uC8FC\uC785\uB429\uB2C8\uB2E4.
        \uCC28\uCCB4\uAC00 \uD3C9\uC18C\uBCF4\uB2E4 \uB450 \uBC30\uB294 \uAC15\uD558\uAC8C
        \uC9C4\uB3D9\uD558\uBA70, \uC5D4\uC9C4\uC5D0\uC11C \uBFDC\uC5B4\uC838 \uB098\uC624\uB294
        \uD478\uB978 \uD654\uC5FC\uC774 \uC120\uB85C \uC704\uB97C \uC218\uB193\uC2B5\uB2C8\uB2E4.
        \uC774 \uC5D4\uC9C4\uC774 \uC644\uC804\uD788 \uD0C0\uBC84\uB9AC\uAE30 \uC804\uAE4C\uC9C0,
        \uB2F9\uC2E0\uC758 \uB300\uC6D0\uB4E4\uC740 \uD3C9\uC18C\uBCF4\uB2E4 \uD6E8\uC52C
        \uBE60\uB974\uACE0 \uAC15\uB825\uD55C \uD589\uB3D9\uB825\uC744 \uBC1C\uD718\uD560
        \uAC83\uC785\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 13
        rewardValue: 3
        rewardDataID: 

