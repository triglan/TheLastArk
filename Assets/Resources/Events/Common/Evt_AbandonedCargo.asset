  eventID: evt_abandoned_cargo
  eventTitle: "\uBC84\uB824\uC9C4 \uD654\uBB3C\uCC28"
  eventDescription: "\uC120\uB85C \uC704\uC5D0 \uBA48\uCDB0 \uC120 \uC815\uCCB4\uBD88\uBA85\uC758
    \uD654\uBB3C\uCC28\uB97C \uBC1C\uACAC\uD558\uACE0 \uC18D\uB3C4\uB97C \uC904\uC785\uB2C8\uB2E4.\n\uB204\uAD70\uAC00
    \uAE09\uD558\uAC8C \uBC84\uB9AC\uACE0 \uAC04 \uD754\uC801\uC774 \uC5ED\uB825\uD569\uB2C8\uB2E4."
  eventImage: {fileID: 21300000, guid: 0548c09b482d1b248a6e3d7c68317839, type: 3}
  options:
  - optionText: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB2E4\uAC00\uAC04\uB2E4."
    requirementType: 0
    requirementValue: 0
    outcomes:
    - outcomeText: "\uBC84\uB824\uC9C4 \uCC28\uB7C9 \uC8FC\uC704\uB97C \uC218\uC0C9\uD558\uB2E4
        \uB5A8\uC5B4\uC838 \uC788\uB358 (\uBB34\uC791\uC704 \uC18C\uBAA8\uD488)\uC744
        \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4."
      probability: 50
      rewards:
      - rewardType: 8
        rewardValue: 1
        rewardDataID: random_consumable
    - outcomeText: "\uC218\uC0C9\uC744 \uC774\uC5B4\uAC14\uC9C0\uB9CC \uC544\uBB34\uAC83\uB3C4
        \uC5BB\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
      probability: 50
      rewards:
      - rewardType: 0
        rewardValue: 0
        rewardDataID: 
  - optionText: "\uCC28\uB7C9\uC758 \uBB38\uC744 \uAC15\uC81C\uB85C \uC5F0\uB2E4."
    requirementType: 0
    requirementValue: 0
    outcomes:
    - outcomeText: "\uCC28\uB7C9 \uB0B4\uBD80\uC5D0 \uC228\uACA8\uC838 \uC788\uB358
        (\uBB34\uC791\uC704 \uC720\uBB3C 1\uAC1C)\uB97C \uD68D\uB4DD\uD588\uC2B5\uB2C8\uB2E4!"
      probability: 30
      rewards:
      - rewardType: 7
        rewardValue: 1
        rewardDataID: random_relic
    - outcomeText: "\uBB38\uC744 \uBD80\uC218\uB2E4\uAC00 \uD280\uC5B4\uB098\uC628
        \uD30C\uD3B8\uC5D0 \uB9DE\uC558\uC2B5\uB2C8\uB2E4. \uBAA8\uB4E0 \uC544\uAD70\uC758
        \uCCB4\uB825 -5."
      probability: 70
      rewards:
      - rewardType: 4
        rewardValue: 5
        rewardDataID: 
  - optionText: "\uCC28\uB7C9\uC5D0\uC11C \uC5F0\uB8CC\uB85C \uC4F8\uB9CC\uD55C \uAC83\uC744
      \uCC3E\uB294\uB2E4."
    requirementType: 0
