  m_Script: {fileID: 11500000, guid: 60773063327c2eb4fbd38c2745ec336b, type: 3}
  m_Name: Evt_AbandonedCargo
  m_EditorClassIdentifier: 
  eventID: evt_abandoned_cargo
  eventTitle: "\uBC84\uB824\uC9C4 \uD654\uBB3C\uCC28"
  eventDescription: "\uD68C\uC0C9\uBE5B \uBA3C\uC9C0\uAC00 \uD718\uB0A0\uB9AC\uB294
    \uC120\uB85C \uC704, \uC815\uCCB4\uBD88\uBA85\uC758 \uD654\uBB3C\uCC28\uAC00
    \uBA48\uCDB0 \uC11C \uC788\uC2B5\uB2C8\uB2E4. \n\uB204\uAD70\uAC00 \uAE09\uD558\uAC8C
    \uB3C4\uB9DD\uCE5C \uB4EF \uC8FC\uC704\uC5D0\uB294 \uC8FC\uC778 \uC5C6\uB294
    \uC2E0\uBC1C\uACFC \n\uC54C \uC218 \uC5C6\uB294 \uBB3C\uAC74\uB4E4\uC774 \uB110\uB824
    \uC788\uC2B5\uB2C8\uB2E4."
  eventImage: {fileID: 21300000, guid: aa4c4cd492545684b948e8e089b25a92, type: 3}
  imageOffset: {x: 100, y: 0}
  imageScale: 1
  options:
  - optionText: "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uB2E4\uAC00\uAC04\uB2E4."
    requirementType: 0
    requirementValue: 0
    requirementDataID: 
    outcomes:
    - outcomeText: "\uB2F9\uC2E0\uC740 \uBC84\uB824\uC9C4 \uCC28\uB7C9\uC744 \uC218\uC0C1\uD558\uAC8C
        \uC0DD\uAC01\uD574 \uC8FC\uBCC0\uC744 \uBA3C\uC800 \uC218\uC0C9\uD558\uAE30\uB85C
        \uD588\uC2B5\uB2C8\uB2E4.\n\uBB34\uAE30\uB97C \uC9D1\uC5B4\uB123\uACE0 \uC870\uC2EC\uC2A4\uB7FD\uAC8C
        \uCC28 \uC8FC\uBCC0\uC744 \uD0D0\uC0C9\uD558\uAE30 \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uADF8\uB7EC\uB2E4
        \uC6B4 \uC88B\uAC8C\uB3C4 \uC544\uC9C1 \uB9C8\uB825\uC774 \uAE43\uB4E0 \uC791\uC740
        \uBC30\uB0AD \uD558\uB098\uB97C \uBC1C\uACAC\uD569\uB2C8\uB2E4.\n\uB2F9\uC2E0\uC740
        \uD639\uC2DC \uBAA8\uB97C \uAE30\uC2B5\uC744 \uACBD\uACC4\uD558\uBA70 \uC2E0\uC18D\uD558\uAC8C
        \uC790\uB9AC\uB97C \uB739\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 8
        rewardValue: 1
        rewardDataID: "\uBB34\uC791\uC704 \uC18C\uBAA8\uD488"
  - optionText: "\uCC28\uB7C9\uC758 \uBB38\uC744 \uAC15\uC81C\uB85C \uC5F0\uB2E4."
    requirementType: 0
    requirementValue: 0
    requirementDataID: 
    outcomes:
    - outcomeText: "\uB2F9\uC2E0\uC740 \uCC28\uB7C9\uC758 \uBB38\uC744 \uC5F4\uC5B4\uBCF4\uAE30\uB85C
        \uD588\uC2B5\uB2C8\uB2E4.\n\n\uB2E8\uB2E8\uD558\uAC8C \uB2EB\uD78C \uB4B7\uBB38\uC5D0
        \uC9C0\uB81B\uB300\uB97C \uBC15\uC544\uB123\uACE0 \uD798\uAECF \uC816\uD799\uB2C8\uB2E4.
        \uADF8 \uC21C\uAC04, \uBB38\uC5D0 \uC0C8\uACA8\uC9C4 \uBCF4\uC548 \uB9C8\uBC95\uC774
        \uCE68\uC785\uC790\uB97C \uAC10\uC9C0\uD558\uACE0 \uCC22\uC5B4\uC9C0\uB294
        \uB4EF\uD55C \uC18C\uB9AC\uC640 \uD568\uAED8 \uD3ED\uBC1C\uD569\uB2C8\uB2E4!\n\n\uC790\uC6B1\uD55C
        \uC5F0\uAE30\uAC00 \uAC77\uD788\uC790, \uD53C\uD22C\uC131\uC774\uAC00 \uB41C
        \uB2F9\uC2E0\uC758 \uC190\uC5D4 \uB9E5\uB3D9\uD558\uB294 \uACE0\uB300\uC758
        \uC720\uBB3C \uD558\uB098\uAC00 \uB4E4\uB824 \uC788\uC2B5\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 7
        rewardValue: 1
        rewardDataID: "\uBB34\uC791\uC704 \uC720\uBB3C"
      - rewardType: 4
        rewardValue: 7
        rewardDataID: 
  - optionText: "\uCC28\uB7C9\uC5D0\uC11C \uC5F0\uB8CC\uB85C \uC4F8\uB9CC\uD55C \uAC83\uC744
      \uCC3E\uB294\uB2E4."
    requirementType: 3
    requirementValue: 8
    requirementDataID: 
    outcomes:
    - outcomeText: "\uB2F9\uC2E0\uC758 \uC2B9\uBB34\uC6D0 \uC911 \uD55C \uBA85\uC774
        \uC228\uC744 \uC8FD\uC774\uACE0 \uCC28\uCCB4\uC5D0 \uC190\uC744 \uC62C\uB9BD\uB2C8\uB2E4.\n\n\uD63C\uD0C1\uD55C
        \uACF5\uAE30 \uC18D\uC5D0\uC11C \uAC00\uB290\uB2E4\uB797\uAC8C \uC9C4\uB3D9\uD558\uB294
        '\uB9C8\uB825\uC758 \uC120'\uC744 \uCC3E\uC544\uB0B4\uB294 \uAC83\uC774\uC8E0.
        \uC9D1\uC911\uB825\uC774 \uADF9\uB3C4\uC5D0 \uB2EC\uD55C \uC21C\uAC04, \"\uCCA0\uCEE5\"
        \uD558\uB294 \uACBD\uCF8C\uD55C \uC18C\uB9AC\uC640 \uD568\uAED8 \uD654\uBB3C\uCC28\uC758
        \uBE44\uBC00 \uACA9\uBCBD\uC774 \uC2A4\uB974\uB974 \uC5F4\uB9BD\uB2C8\uB2E4.
        \uADF8 \uC548\uC5D0\uB294 \uC218\uB9CE\uC740 \uBD80\uD488\uACFC \uBCF4\uBB3C\uC774
        \uBCF4\uAD00\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC740 \uC5F4\uCC28\uC758
        \uC5D4\uC9C4\uC744 \uB354\uC6B1 \uAC15\uD654\uD560 \uC218 \uC788\uB294 \uADC0\uC911\uD55C
        \uC790\uC6D0\uC744 \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4."
      probability: 100
      rewards:
      - rewardType: 1
        rewardValue: 30
        rewardDataID: 
      - rewardType: 9
        rewardValue: 1
        rewardDataID: 
